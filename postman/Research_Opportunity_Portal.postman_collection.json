{
  "info": {
    "_postman_id": "4a7e8b9c-2d3e-4f5a-6b7c-8d9e0f1a2b3c",
    "name": "University Research Opportunity Portal API",
    "description": "Complete Postman collection for CN Assignment #01. Demonstrates all required CRUD operations, status transitions, input validation error handling, and 404 responses using automated Postman tests and variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/opportunities",
      "type": "string",
      "description": "Base URL of the Research Opportunities REST API"
    },
    {
      "key": "opportunityId",
      "value": "1",
      "type": "string",
      "description": "ID of the research opportunity used for retrieve, update, and status change tests"
    },
    {
      "key": "deletedOpportunityId",
      "value": "3",
      "type": "string",
      "description": "ID of the research opportunity used for delete and 404 tests"
    }
  ],
  "item": [
    {
      "name": "1. Create Research Opportunity #1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response contains created opportunity data with ID\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.have.property(\"id\");",
              "    pm.expect(jsonData.data.status).to.eql(\"Open\");",
              "    ",
              "    // Store opportunityId for subsequent retrieve & update requests",
              "    pm.collectionVariables.set(\"opportunityId\", String(jsonData.data.id));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Edge AI Optimization in Software Defined Networks\",\n  \"description\": \"Investigating low-latency inference pipelines deployed directly on SDN edge switches.\",\n  \"research_area\": \"Computer Networks & AI\",\n  \"faculty_name\": \"Dr. Arshad Khan\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, Mininet, PyTorch, C++\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2026-11-15\",\n  \"status\": \"Open\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        },
        "description": "Creates first research opportunity. Sets {{opportunityId}} dynamically."
      },
      "response": []
    },
    {
